APP_PORT=2266
DATA_DIR=/app/data
OLLAMA_BASE_URL=http://host.docker.internal:11434
# OPENAI_API_KEY=
# GEMINI_API_KEY=


# Encrypts API keys saved from the interface. Without it they are stored as
# written; with APP_ENV=production they are read from this file only and the
# interface refuses to store them at all.
# APP_SECRET_KEY=
# APP_ENV=production

# When set, every request except /health must carry `Authorization: Bearer <token>`.
# APP_AUTH_TOKEN=

# Requests per minute per client, on the two endpoints that cost money. 0 disables.
# APP_RATE_LIMIT_CHAT=30
# APP_RATE_LIMIT_UPLOAD=20

# json (default) or text; INFO by default.
# APP_LOG_FORMAT=json
# APP_LOG_LEVEL=INFO
